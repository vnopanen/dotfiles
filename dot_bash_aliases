cleantaint() {
  local repo="${PWD}"
  local taints

  taints="$(find "$repo" -name '*.taint' -type f | sort)"
  if [ -z "$taints" ]; then
    echo "no .taint files found"
    return 0
  fi

  printf '%s\n' "$taints"
  read -r -p "clear these .taint files? [y/N] " ans
  case "$ans" in
    y|Y|yes|YES)
      printf '%s\n' "$taints" | xargs -r rm -f
      ;;
    *)
      echo "aborted"
      ;;
  esac
}

pc() {
  local device=/dev/ttyUSB0
  local arg
  local -a picocom_args=()

  for arg in "$@"; do
    case "$arg" in
      /dev/*)
        device="$arg"
        ;;
      [0-9]) device="/dev/ttyUSB${arg}" ;;
      *) picocom_args+=("$arg") ;;
    esac
  done

  picocom -b 115200 "${picocom_args[@]}" "$device"
}

